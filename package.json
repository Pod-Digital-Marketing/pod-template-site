{
  "name": "pod-template-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "backend": "node scripts/backend.mjs",
    "dev:local": "node scripts/backend.mjs local",
    "dev:atlas": "node scripts/backend.mjs atlas",
    "dev:mock": "node scripts/backend.mjs mock",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:commerce": "graphql-codegen --config codegen.commerce.ts",
    "gen:acf": "node scripts/generate-acf-blocks.mjs",
    "check:contract": "node scripts/check-live-contract.mjs",
    "lhci": "lhci autorun",
    "links": "start-server-and-test start http://localhost:3000 links:run",
    "links:run": "linkinator http://localhost:3000 --config linkinator.config.json",
    "jsonld": "start-server-and-test start http://localhost:3000 jsonld:run",
    "jsonld:run": "node scripts/validate-jsonld.mjs",
    "a11y": "start-server-and-test start http://localhost:3000 a11y:run",
    "a11y:run": "pa11y-ci"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@sentry/nextjs": "^10.75.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "sanitize-html": "^2.17.7",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.1",
    "@graphql-codegen/client-preset": "^6.2.0",
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^6.0.2",
    "linkinator": "^7.6.1",
    "pa11y-ci": "^4.1.1",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^4",
    "typescript": "^6"
  },
  "packageManager": "pnpm@10.12.1"
}
